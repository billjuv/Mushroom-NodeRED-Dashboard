    {
        "id": "3c1534f22e992ce3",
        "type": "ui-template",
        "z": "ff63fb8bd58c30b0",
        "group": "c8646f9b073751c8",
        "page": "",
        "ui": "",
        "name": "CO2 Table",
        "order": 2,
        "width": "6",
        "height": "7",
        "format": "<template>\n    <table style=\"width:100%; border-collapse:collapse; font-size:16px;\">\n        <thead>\n            <tr>\n                <th style=\"text-align:left; padding:3px 8px; border-bottom:2px solid #ccc; color:#555;\">Location</th>\n                <th style=\"text-align:right; padding:3px 8px; border-bottom:2px solid #ccc; color:#555;\">Now</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr v-for=\"row in msg.payload\" :key=\"row.loc\">\n                <td style=\"padding:3px 8px;\">\n                    <div style=\"color:#333; font-weight:550;\">{{ row.loc }}</div>\n                    <div style=\"font-size:15px; color:#666; margin-top:1px;\">\n                        Min: {{ row.min }}&nbsp;&nbsp;Max: {{ row.max }}&nbsp;&nbsp;Avg: {{ row.avg }}\n                    </div>\n                </td>\n                <td\n                    style=\"padding:3px 8px; text-align:right; font-size:20px; font-weight:500; color:#006fa3; vertical-align:middle;\">\n                    {{ row.cur }}\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</template>",
        "storeOutMessages": true,
        "passthru": true,
        "templateScope": "local",
        "className": "",
        "x": 970,
        "y": 480,
        "wires": [
