    {
        "id": "1de6708b2b12314f",
        "type": "function",
        "z": "ff63fb8bd58c30b0",
        "name": "Build CO2 Table",
        "func": "//flow.set('co2_table', null); // clears table - turn back off\n\nvar sensors = flow.get('co2_table') || {\n    'F.F. scd1 %': { loc: 'Fruiting Front - scd1', values: [], cur: '--', min: '--', max: '--', avg: '--' },\n    'F.R. ezo2 %': { loc: 'Fruiting Rear - ezo2', values: [], cur: '--', min: '--', max: '--', avg: '--' },\n    'F.R. scd2 %': { loc: 'Fruiting Rear - scd2', values: [], cur: '--', min: '--', max: '--', avg: '--' },\n    'Incub. ezo3 %': { loc: 'Incubation - ezo3', values: [], cur: '--', min: '--', max: '--', avg: '--' },\n    'Incub. scd3 %': { loc: 'Incubation - scd3', values: [], cur: '--', min: '--', max: '--', avg: '--' }\n};\n\nvar key = msg.topic;\n\nif (sensors[key] !== undefined) {\n    var val = parseFloat(msg.payload);\n    if (!isNaN(val)) {\n        var now = Date.now();\n        var cutoff = now - 1440 * 60 * 1000;\n\n        if (!sensors[key].values) sensors[key].values = [];\n        sensors[key].values.push({ t: now, v: val });\n        sensors[key].values = sensors[key].values.filter(function (e) { return e.t >= cutoff; });\n\n        var vals = sensors[key].values.map(function (e) { return e.v; });\n        var mn = Math.min.apply(null, vals);\n        var mx = Math.max.apply(null, vals);\n        var av = vals.reduce(function (a, b) { return a + b; }, 0) / vals.length;\n\n        sensors[key].cur = val.toFixed(0) + ' ppm';\n        //sensors[key].min = mn.toFixed(0) + ' ppm';\n        //sensors[key].max = mx.toFixed(0) + ' ppm';\n        //sensors[key].avg = (Math.round(av * 100) / 100).toFixed(0) + ' ppm';\n    \n        //sensors[key].cur = val.toFixed(0) ;\n        sensors[key].min = mn.toFixed(0) ;\n        sensors[key].max = mx.toFixed(0) ;\n        sensors[key].avg = (Math.round(av * 100) / 100).toFixed(0) ;\n    }\n}\n\nflow.set('co2_table', sensors);\nmsg.payload = Object.values(sensors);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
        "y": 420,
