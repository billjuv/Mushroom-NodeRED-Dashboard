    {
        "id": "5dcd2b1a233d9def",
        "type": "exec",
        "z": "67a2983f73b432d0",
        "command": "echo \"TEMP:$(vcgencmd measure_temp)\"; echo \"LOAD:$(cat /proc/loadavg)\"; echo \"CORES:$(nproc)\"; free -m | awk 'NR==2{print \"MEM_TOTAL:\"$2; print \"MEM_USED:\"$3; print \"MEM_FREE:\"$4; print \"MEM_SHARED:\"$5; print \"MEM_BUFFCACHE:\"$6; print \"MEM_AVAIL:\"$7} NR==3{print \"SWAP_TOTAL:\"$2; print \"SWAP_USED:\"$3; print \"SWAP_FREE:\"$4}'; echo \"DISK:$(df -h / | awk 'NR==2{print $5}')\"; echo \"UPTIME:$(cat /proc/uptime)\"; echo \"HOST:$(hostname)\"; echo \"IP:$(hostname -I)\"",
        "addpay": false,
        "append": "",
        "useSpawn": "",
        "timer": "",
        "winHide": false,
        "name": "Collect Stats",
        "x": 210,
        "y": 180,
        "wires": [
            [
                "272271c725be1fa8"
            ],
            [],
            []
        ]
    },
    {
        "id": "272271c725be1fa8",
        "type": "function",
        "z": "67a2983f73b432d0",
        "name": "Parse All Stats",
        "func": "var lines = msg.payload.trim().split('\\n');\nvar raw = {};\nlines.forEach(function (line) {\n    var idx = line.indexOf(':');\n    if (idx === -1) return;\n    raw[line.substring(0, idx)] = line.substring(idx + 1).trim();\n});\n\nvar tempMatch = (raw.TEMP || '').match(/([\\d.]+)/);\nmsg.tempC = tempMatch ? parseFloat(tempMatch[1]) : null;\n\nvar loadParts = (raw.LOAD || '').split(' ');\nvar load1 = parseFloat(loadParts[0]) || 0;\nvar cores = parseInt(raw.CORES) || 1;\nmsg.loadPct = Math.round((load1 / cores) * 1000) / 10;\n\nvar memTotal = parseFloat(raw.MEM_TOTAL) || 0;\nvar memUsed = parseFloat(raw.MEM_USED) || 0;\nvar memFree = parseFloat(raw.MEM_FREE) || 0;\nvar memShared = parseFloat(raw.MEM_SHARED) || 0;\nvar memBuffCache = parseFloat(raw.MEM_BUFFCACHE) || 0;\nvar memAvailable = parseFloat(raw.MEM_AVAIL) || 0;\nvar swapTotal = parseFloat(raw.SWAP_TOTAL) || 0;\nvar swapUsed = parseFloat(raw.SWAP_USED) || 0;\nvar swapFree = parseFloat(raw.SWAP_FREE) || 0;\n\nmsg.memAvailableMiB = memAvailable;\nmsg.memAvailablePct = memTotal ? Math.round((memAvailable / memTotal) * 1000) / 10 : 0;\nmsg.swapUsedMiB = swapUsed;\n\nmsg.diskPct = parseInt(raw.DISK) || 0;\n\nvar totalSeconds = parseFloat((raw.UPTIME || '0').split(' ')[0]);\nvar days = Math.floor(totalSeconds / 86400);\nvar hours = Math.floor((totalSeconds % 86400) / 3600);\nvar minutes = Math.floor((totalSeconds % 3600) / 60);\nmsg.uptime = days + \"d \" + hours + \"h \" + minutes + \"m\";\n\nmsg.hostname = raw.HOST || 'unknown';\nmsg.ip = (raw.IP || '').trim();\nmsg.topic = \"status/\" + msg.hostname + \"/ip\";\n\nmsg.lastUpdated = new Date().toLocaleTimeString('en-US');\n\nmsg.payload = [\n    { Type: \"Memory\", Total: memTotal, Used: memUsed, Free: memFree, Shared: memShared, \"Buff/Cache\": memBuffCache, Available: memAvailable },\n    { Type: \"Swap\", Total: swapTotal, Used: swapUsed, Free: swapFree }\n];\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 180,
        "wires": [
