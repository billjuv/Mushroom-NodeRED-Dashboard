    {
        "id": "81e4382e842c9c7d",
        "type": "function",
        "z": "9991a25bb74de0a9",
        "g": "24769cd12c56318c",
        "name": "Save Range",
        "func": "flow.set('range', msg.payload);\n\n// Pre-fill custom dates if switching to Custom\nif(msg.payload === 'custom'){\n    const now = new Date();\n    const today = now.toISOString().split('T')[0];\n    flow.set('start', flow.get('start') || today);\n    flow.set('stop', flow.get('stop') || today);\n}\nreturn null;",
        "outputs": 0,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 100,
        "wires": []
    },
