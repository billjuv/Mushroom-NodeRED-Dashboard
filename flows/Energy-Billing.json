    {
        "id": "690b67f120fcda8b",
        "type": "function",
        "z": "9991a25bb74de0a9",
        "g": "24769cd12c56318c",
        "name": "* Build InfluxQL Query",
        "func": "const measurement = \"emeter/total_kWh\";\nconst field = \"value\";\n\nlet start = msg.start;\nlet stop = msg.stop;\n\nif (!start || !stop) {\n    node.error(\"Missing start or stop time\");\n    return null;\n}\n\nconst startNs = new Date(start).getTime() * 1000000;\nconst stopNs = new Date(stop).getTime() * 1000000;\n\nconst query = `SELECT FIRST(\"${field}\"), LAST(\"${field}\") FROM \"${measurement}\" WHERE time >= ${startNs} AND time <= ${stopNs}`;\n\nmsg.url = `http://localhost:8086/query?db=mushroom_data&q=${encodeURIComponent(query)}`;\n//msg.url = `http://10.0.1.209:8086/query?db=mushroom_data&q=${encodeURIComponent(query)}`;\n//msg.method = \"GET\";\n//msg.headers = { \"Content-Type\": \"application/json\" };\n\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"Querying...\" });\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 280,
        "wires": [
            [
                "92f5d7f39b48c250",
                "3df139d8488ceb68"
            ]
        ]
    },
    {
        "id": "a01ed8a4aa443542",
        "type": "function",
        "z": "9991a25bb74de0a9",
        "g": "24769cd12c56318c",
        "name": "Calculate Usage (InfluxQL)",
        "func": "// InfluxDB HTTP API returns:\n// {\"results\":[{\"series\":[{\"columns\":[\"time\",\"first\",\"last\"],\"values\":[[\"...\",firstVal,lastVal]]}]}]}\n\ntry {\n    const series = msg.payload.results[0].series[0];\n    const cols = series.columns;\n    const vals = series.values[0];\n\n    const firstIdx = cols.indexOf(\"first\");\n    const lastIdx = cols.indexOf(\"last\");\n\n    const firstValue = vals[firstIdx];\n    const lastValue = vals[lastIdx];\n\n    if (firstValue === null || lastValue === null) {\n        node.warn('Null values in result');\n        msg.payload = { usage_kWh: 0, error: 'Null data' };\n        return msg;\n    }\n\n    const usage = lastValue - firstValue;\n\n    msg.payload = { usage_kWh: usage, data_points: 2 };\n\n    node.status({ fill: \"green\", shape: \"dot\", text: `${usage.toFixed(2)} kWh` });\n\n} catch (e) {\n    node.error(\"Parse error: \" + e.message);\n    msg.payload = { usage_kWh: 0, error: 'Parse error' };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 400,
        "wires": [
            [
                "1e652bd605e0a176",
                "98b323f4d3c50eec"
            ]
        ]
    },
    {
        "id": "1e652bd605e0a176",
        "type": "function",
        "z": "9991a25bb74de0a9",
        "g": "24769cd12c56318c",
        "name": "Format for Dashboard",
        "func": "if (msg.payload.error) {\n    msg.payload = `Error: ${msg.payload.error}`;\n} else {\n    msg.payload = `Energy Used: ${msg.payload.usage_kWh.toFixed(2)} kWh`;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 280,
        "y": 460,
        "wires": [
            [
                "ddb7fb3481183021"
            ]
        ]
    },
    {
        "id": "75f3d4b74d6f58e5",
        "type": "function",
        "z": "9991a25bb74de0a9",
        "g": "24769cd12c56318c",
        "name": "Build Date Range",
        "func": "// Read saved values\nlet range = flow.get('range') || 'day';\nlet start = flow.get('start');\nlet stop = flow.get('stop');\nconst now = new Date();\n\n// Helper to convert local date → UTC ISO\nfunction toUTCISOString(date) {\n    const utc = new Date(date.getTime() - date.getTimezoneOffset() * 60000);\n    return utc.toISOString();\n}\n\nconst ONE_HOUR = 60 * 60 * 1000;\nlet localStart, localStop;\n\n// --- Determine local start/stop ---\nif (range === 'day') {\n    localStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n    localStop = new Date(now);\n}\nelse if (range === 'week') {\n    localStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 7);\n    localStop = new Date(now);\n}\nelse if (range === 'month') {\n    localStart = new Date(now.getFullYear(), now.getMonth(), 1);\n    localStop = new Date(now);\n}\nelse if (range === 'custom') {\n    if (!start || !stop) {\n        node.warn('Custom range missing, defaulting to today');\n        localStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n        localStop = new Date(now);\n    } else {\n        localStart = new Date(start);\n        localStop = new Date(stop);\n        localStop.setHours(23, 59, 59, 999);\n    }\n}\n\n// --- Add ±1 hour buffer and convert to UTC ---\nmsg.start = toUTCISOString(new Date(localStart.getTime() - ONE_HOUR));\nmsg.stop = toUTCISOString(new Date(localStop.getTime() + ONE_HOUR));\n\n// --- Show quick visual status ---\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: `Range: ${range} | ${localStart.toLocaleString()}–${localStop.toLocaleString()}`\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 220,
        "wires": [
            [
                "690b67f120fcda8b",
                "160f3ab6ea815bbe"
            ]
        ]
    },
