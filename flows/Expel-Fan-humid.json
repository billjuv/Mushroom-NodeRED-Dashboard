    {
        "id": "815f29e71138857c",
        "type": "function",
        "z": "87d85e89d8eecc24",
        "g": "2f3a3686eb4b6893",
        "name": "Apply Fan On Delay",
        "func": "// Override ON skips delay entirely\nif (msg.override === true) {\n    node.status({ fill: 'green', shape: 'dot', text: 'Override ON - no delay' });\n    node.send([msg, { payload: 'OFF' }]);  // fan ON, LED off (no delay active)\n    return null;\n}\n\nlet delayMinutes = Number(flow.get('fanOnDelay', 'file')) || 0;\nlet delayMs = delayMinutes * 60 * 1000;\n\nif (delayMs === 0) {\n    node.status({ fill: 'green', shape: 'dot', text: 'No delay - ON' });\n    node.send([msg, { payload: 'OFF' }]);  // fan ON, LED off (no delay active)\n    return null;\n}\n\n// Delay is active — light up the LED\nnode.status({ fill: 'yellow', shape: 'dot', text: `Delay: ${delayMinutes}m pending...` });\nnode.send([null, { payload: 'ON' }]);  // hold fan, LED on\n\nsetTimeout(() => {\n    node.status({ fill: 'green', shape: 'dot', text: 'Delay done - ON sent' });\n    node.send([msg, { payload: 'OFF' }]);  // fan ON, LED off\n}, delayMs);\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
