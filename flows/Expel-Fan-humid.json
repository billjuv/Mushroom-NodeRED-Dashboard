    {
        "id": "fd26f7109cfd5991",
        "type": "function",
        "z": "87d85e89d8eecc24",
        "g": "2f3a3686eb4b6893",
        "name": "High Threshold (set, on/off)",
        "func": "let value;\nif (msg.source === 'override') {\n    // Triggered by override button — use last saved humidity\n    value = Number(flow.get('lastHumidity', 'file')) || 0;\n} else {\n    // Real sensor reading — save it and use it\n    value = Number(msg.payload);\n    flow.set('lastHumidity', value, 'file');\n}\n\nlet lowThreshold = Number(flow.get('lowThreshold', 'file')) || 0;\nlet highThreshold = Number(flow.get('highThreshold', 'file')) || 100;\nlet overrideMode = Number(flow.get('overrideMode', 'file')) || 0;\nlet lastState = Number(flow.get('lastState', 'memory')) || 0;\n\nnode.status({\n    fill: 'blue', shape: 'dot',\n    text: `RH:${value} Lo:${lowThreshold} Hi:${highThreshold} Mode:${overrideMode} Last:${lastState}`\n});\n\n// Override OFF — immediate, no delay\nif (overrideMode === 1) {\n    if (lastState !== 0) {\n        flow.set('lastState', 0, 'memory');\n        return { payload: 0, override: true };\n    }\n    return null;\n}\n\n// Override ON — immediate, no delay\nif (overrideMode === 2) {\n    if (lastState !== 1) {\n        flow.set('lastState', 1, 'memory');\n        return { payload: 1, override: true };\n    }\n    return null;\n}\n\n// Auto mode — only fire on state change\nif (lastState === 0 && value > highThreshold) {\n    let puckOn = global.get('puckPlugOn') === 1;\n    if (puckOn) {\n        node.status({\n            fill: 'orange', shape: 'ring',\n            text: `Blocked: puck ON (RH:${value})`\n        });\n        return null;\n    }\n    flow.set('lastState', 1, 'memory');\n    return { payload: 1, override: false };\n}\nif (lastState === 1 && value < lowThreshold) {\n    flow.set('lastState', 0, 'memory');\n    return { payload: 0, override: false };\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
