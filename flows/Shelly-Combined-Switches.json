    {
        "id": "6c6963004d26ad20",
        "type": "function",
        "z": "7da3141dd86bd399",
        "g": "53b5e93e4d8b0431",
        "name": "Main Timer 1",
        "func": "// Retrieve existing saved times (persistent)\nvar saved = flow.get(\"timer1_times\", \"file\") || { on: \"00:00:00\", off: \"00:00:00\" };\n\n// Merge incoming msg values\nif (msg.topic === \"on_time1\" && msg.payload) saved.on = msg.payload;\nif (msg.topic === \"off_time1\" && msg.payload) saved.off = msg.payload;\n\n// Validate times\nfunction checktime(time) {\n    if (!time) return false;\n    const parts = time.split(\":\");\n    if (parts.length < 2) return false;\n    if (parseInt(parts[0]) > 23 || parseInt(parts[1]) > 59) return false;\n    if (parts[2] !== undefined && parseInt(parts[2]) > 59) return false;\n    return true;\n}\nif (!checktime(saved.on) || !checktime(saved.off)) {\n    node.warn(\"Invalid times, reverting to previous or default\");\n    saved.on = saved.on || \"00:00:00\";\n    saved.off = saved.off || \"00:00:00\";\n}\n\n// Persist both times\nflow.set(\"timer1_times\", saved, \"file\");\n\n// Also keep a temporary buffer for UI display (optional)\nflow.set(\"timer1_input_buffer\", { on: saved.on, off: saved.off });\n\n// Build message for EZTimer & dashboard\nmsg.payload = { ontime: saved.on, offtime: saved.off };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 300,
        "wires": [
            [
                "88b45bfe1544f965",
                "13b63230ddd44948"
            ]
        ]
    },
    {
        "id": "0a105a7978282b1b",
